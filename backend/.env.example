# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/miqraaz
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/miqraaz?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/miqraaz

# Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Initial Bootstrap Admin Credentials (used if run via npm run bootstrap-admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@miqraaz.com
ADMIN_PASSWORD=AdminPassword123!
